# =====================================================================
#  Goal: version code + docs + small result tables; NEVER commit large
#  tensors, raw datasets, caches, or secrets.
# =====================================================================

# ---- Python ----
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/

# ---- Virtual environment ----
.venv/

# ---- Secrets & machine-local tooling (NEVER commit) ----
.env
.env.*
.claude/settings.local.json

# ---- Raw datasets (downloadable; regenerated by scripts) ----
/data/*
!/data/.gitkeep
!/data/SOURCES.md
!/data/push_to_hf.py
!/data/.gitattributes

# ---- Heavy per-experiment artifacts (regenerable) ----
assets/experiments/**/hidden/
assets/experiments/**/cache/
assets/experiments/**/samples/
assets/experiments/**/logs/
assets/experiments/**/plots/
**/judge_cache/

# ---- Large binary / tensor / data formats anywhere ----
*.npy
*.npz
*.pt
*.pkl
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
*.db
*.sqlite
*.parquet
*.arrow
*.tar
*.tar.gz
*.tgz
*.zip

# ---- Generation shards (regenerable, can be large) ----
*.jsonl

# ---- Decision-tracker generated viewer (rebuild via scripts) ----
#      NOTE: docs/decisions/index.md IS tracked — it is what sessions read.
docs/decisions/graph.html
docs/decisions/.build-stamp

# ---- OS / editor cruft ----
.DS_Store
*.swp
.ipynb_checkpoints/
